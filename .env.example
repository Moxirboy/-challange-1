# LLM configuration. Any OpenAI-compatible /chat/completions + /embeddings endpoint.
# The reference run (the committed out/) used Google AI Studio's OpenAI-compatible
# endpoint with gemini-3.1-flash-lite -- that specific model is what actually
# completes a full run inside the free tier's quota; see README.md / WRITEUP.md.

CHALLENGE_API_KEY=
CHALLENGE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CHALLENGE_LLM_MODEL=gemini-3.1-flash-lite
CHALLENGE_EMBED_MODEL=gemini-embedding-001

# OpenRouter alternative:
# CHALLENGE_LLM_BASE_URL=https://openrouter.ai/api/v1
# CHALLENGE_LLM_MODEL=google/gemini-2.5-flash
# CHALLENGE_EMBED_MODEL=openai/text-embedding-3-small
